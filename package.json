{
  "name": "sorawich-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create sorawich_portfolio_db",
    "db:migrate:local": "wrangler d1 execute sorawich_portfolio_db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute sorawich_portfolio_db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
